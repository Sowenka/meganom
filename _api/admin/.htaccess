# Restrict admin API to whitelisted IPs only.
# REMOTE_ADDR is the real visitor IP on Spaceweb (nginx -> Apache). The PHP check
# in config.php (require_admin_ip) is the primary guard; keep both lists in sync.
# Both blocks are needed: Apache 2.4 uses Require, Apache 2.2 uses Order/Allow.
<IfModule mod_authz_core.c>
  Require ip 155.212.6.85 92.241.231.106 82.38.67.212 82.40.37.155 77.222.40.4 127.0.0.1
</IfModule>
<IfModule !mod_authz_core.c>
  Order Deny,Allow
  Deny from all
  Allow from 155.212.6.85
  Allow from 92.241.231.106
  Allow from 82.38.67.212
  Allow from 82.40.37.155
  Allow from 77.222.40.4
  Allow from 127.0.0.1
</IfModule>
