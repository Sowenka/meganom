# One-time setup scripts: never reachable over HTTP.
# Run them from SSH instead, e.g. `php8.3 init-rooms.php`.
# Both blocks are needed: Apache 2.4 uses Require, Apache 2.2 uses Order/Deny.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order Deny,Allow
  Deny from all
</IfModule>
